{
  "name": "folioport",
  "version": "1.0.0",
  "description": "Developer portfolio generator - beautiful portfolios in seconds",
  "type": "module",
  "bin": {
    "folioport": "./dist/bin/cli.js",
    "create-folioport": "./dist/bin/create.js"
  },
  "main": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./builder": {
      "types": "./dist/lib/core/builder.d.ts",
      "import": "./dist/lib/core/builder.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "types"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "jest",
    "lint": "eslint ."
  },
  "keywords": [
    "portfolio",
    "generator",
    "static-site",
    "cli",
    "developer",
    "website",
    "typescript",
    "ssg"
  ],
  "author": "Your Name <your.email@example.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xdps/folioport.git"
  },
  "bugs": {
    "url": "https://github.com/0xdps/folioport/issues"
  },
  "homepage": "https://github.com/0xdps/folioport#readme",
  "dependencies": {
    "commander": "^11.0.0",
    "handlebars": "^4.7.8",
    "esbuild": "^0.19.0",
    "html-minifier-terser": "^7.2.0",
    "chalk": "^5.3.0",
    "ora": "^7.0.1",
    "fs-extra": "^11.1.1",
    "chokidar": "^3.5.3",
    "express": "^4.18.2",
    "livereload": "^0.9.3",
    "glob": "^10.3.10",
    "js-yaml": "^4.1.0",
    "@iarna/toml": "^2.2.5"
  },
  "devDependencies": {
    "jest": "^29.0.0",
    "eslint": "^8.0.0",
    "typescript": "^5.2.0",
    "@types/node": "^20.0.0",
    "@types/fs-extra": "^11.0.0",
    "@types/express": "^4.17.0",
    "@types/js-yaml": "^4.0.0",
    "@types/jest": "^29.0.0",
    "tsx": "^3.12.0"
  }
}

