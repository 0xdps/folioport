{
  "name": "folioport",
  "version": "2.1.0",
  "description": "Developer portfolio generator - beautiful portfolios in seconds",
  "type": "module",
  "bin": {
    "folioport": "./build/bin/cli.js"
  },
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    },
    "./builder": {
      "types": "./build/core/builder.d.ts",
      "import": "./build/core/builder.js"
    }
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && npm run copy-templates",
    "copy-templates": "cp -r src/templates build/",
    "dev": "tsc --watch",
    "clean": "rm -rf build",
    "prepublishOnly": "npm run clean && npm run build && npm run lint",
    "test": "jest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "release": "./scripts/release.sh"
  },
  "keywords": [
    "portfolio",
    "generator",
    "static-site",
    "cli",
    "developer",
    "website",
    "typescript",
    "ssg"
  ],
  "author": "Devendra Pratap Singh <dps.manit@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xdps/folioport.git"
  },
  "bugs": {
    "url": "https://github.com/0xdps/folioport/issues"
  },
  "homepage": "https://github.com/0xdps/folioport#readme",
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "chalk": "^5.3.0",
    "chokidar": "^3.5.3",
    "commander": "^11.0.0",
    "esbuild": "^0.19.0",
    "express": "^4.18.2",
    "fs-extra": "^11.1.1",
    "glob": "^10.3.10",
    "handlebars": "^4.7.8",
    "html-minifier-terser": "^7.2.0",
    "js-yaml": "^4.1.0",
    "livereload": "^0.9.3",
    "ora": "^7.0.1",
    "prompts": "^2.4.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "testMatch": [
      "<rootDir>/test/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts"
    ],
    "passWithNoTests": true
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/express": "^4.17.0",
    "@types/fs-extra": "^11.0.0",
    "@types/jest": "^29.0.0",
    "@types/js-yaml": "^4.0.0",
    "@types/node": "^20.0.0",
    "@types/prompts": "^2.4.9",
    "eslint": "^8.57.1",
    "globals": "^16.4.0",
    "jest": "^29.0.0",
    "jiti": "^2.6.1",
    "ts-jest": "^29.4.5",
    "tsx": "^3.12.0",
    "typescript": "^5.2.0",
    "typescript-eslint": "^8.46.2"
  }
}
