<!DOCTYPE html>
<html lang="{{meta.language}}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  {{{metaTags}}}
  
  <link rel="icon" type="image/svg+xml" href="{{meta.favicon}}">
  <link rel="stylesheet" href="assets/css/styles.min.css">
  
  {{{schemaTag}}}
</head>
<body>
  <!-- Header -->
  <header class="header">
    <nav class="nav container">
      <a href="#" class="nav__logo">{{hero.name}}</a>
      <ul class="nav__menu">
        <li><a href="#about" class="nav__link">About</a></li>
        {{#if experience}}
        <li><a href="#experience" class="nav__link">Experience</a></li>
        {{/if}}
        {{#if projects}}
        <li><a href="#projects" class="nav__link">Projects</a></li>
        {{/if}}
        <li><a href="#contact" class="nav__link">Contact</a></li>
      </ul>
      {{#if config.features.darkMode}}
      <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme">
        <svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
      {{/if}}
    </nav>
  </header>

  <!-- Hero Section -->
  <section class="hero" id="hero">
    <div class="container">
      <div class="hero__content">
        {{#if hero.image}}
        <img src="{{hero.image}}" alt="{{hero.name}}" class="hero__image">
        {{else}}
        <div class="hero__image hero__image--placeholder">
          <svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 24 24" fill="currentColor" aria-label="Profile">
            <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
          </svg>
        </div>
        {{/if}}
        <h1 class="hero__name">{{hero.name}}</h1>
        <p class="hero__tagline">{{hero.tagline}}</p>
        <p class="hero__description">{{hero.description}}</p>
        
        {{#if social}}
        <div class="hero__social">
          {{#if social.github}}
          <a href="https://github.com/{{social.github}}" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          </a>
          {{/if}}
          {{#if social.linkedin}}
          <a href="https://linkedin.com/in/{{social.linkedin}}" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
          </a>
          {{/if}}
          {{#if social.twitter}}
          <a href="https://twitter.com/{{social.twitter}}" target="_blank" rel="noopener noreferrer" aria-label="Twitter">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/>
            </svg>
          </a>
          {{/if}}
          {{#if social.email}}
          <a href="mailto:{{social.email}}" aria-label="Email">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          </a>
          {{/if}}
        </div>
        {{/if}}
        
        {{#if hero.cta}}
        <div class="hero__cta">
          {{#if hero.cta.primary}}
          <a href="{{hero.cta.primary.link}}" class="btn btn--primary">{{hero.cta.primary.text}}</a>
          {{/if}}
          {{#if hero.cta.secondary}}
          <a href="{{hero.cta.secondary.link}}" class="btn btn--secondary">{{hero.cta.secondary.text}}</a>
          {{/if}}
        </div>
        {{/if}}
      </div>
    </div>
  </section>

  <!-- About Section -->
  {{#if about}}
  <section class="section about" id="about">
    <div class="container">
      <h2 class="section__title">{{about.title}}</h2>
      <div class="about__content">
        {{#each about.paragraphs}}
        <p class="about__text">{{this}}</p>
        {{/each}}
        
        {{#if about.skills}}
        <div class="skills">
          <h3 class="skills__title">Skills & Technologies</h3>
          <div class="skills__list">
            {{#each about.skills}}
            <span class="skill-chip">{{this}}</span>
            {{/each}}
          </div>
        </div>
        {{/if}}
      </div>
    </div>
  </section>
  {{/if}}

  <!-- Experience Section -->
  {{#if experience}}
  <section class="section experience" id="experience">
    <div class="container">
      <h2 class="section__title">{{experience.title}}</h2>
      <div class="timeline">
        {{#each experience.items}}
        <div class="timeline__item">
          <div class="timeline__marker"></div>
          <div class="timeline__content">
            <h3 class="timeline__role">{{role}}</h3>
            <p class="timeline__company">{{company}}</p>
            <p class="timeline__period">{{period}}</p>
            <p class="timeline__description">{{description}}</p>
            {{#if technologies}}
            <div class="timeline__tech">
              {{#each technologies}}
              <span class="tech-chip">{{this}}</span>
              {{/each}}
            </div>
            {{/if}}
          </div>
        </div>
        {{/each}}
      </div>
    </div>
  </section>
  {{/if}}

  <!-- Projects Section -->
  {{#if projects}}
  <section class="section projects" id="projects">
    <div class="container">
      <h2 class="section__title">{{projects.title}}</h2>
      <div class="projects__grid">
        {{#each projects.items}}
        <div class="project-card">
          {{#if image}}
          <img src="{{image}}" alt="{{title}}" class="project-card__image">
          {{/if}}
          <div class="project-card__content">
            <h3 class="project-card__title">{{title}}</h3>
            <p class="project-card__description">{{description}}</p>
            {{#if technologies}}
            <div class="project-card__tech">
              {{#each technologies}}
              <span class="tech-chip">{{this}}</span>
              {{/each}}
            </div>
            {{/if}}
            <div class="project-card__links">
              {{#if link}}
              <a href="{{link}}" target="_blank" rel="noopener noreferrer" class="btn btn--small">GitHub</a>
              {{/if}}
              {{#if demo}}
              <a href="{{demo}}" target="_blank" rel="noopener noreferrer" class="btn btn--small btn--secondary">Live Demo</a>
              {{/if}}
            </div>
          </div>
        </div>
        {{/each}}
      </div>
    </div>
  </section>
  {{/if}}

  <!-- Education Section -->
  {{#if education}}
  <section class="section education" id="education">
    <div class="container">
      <h2 class="section__title">{{education.title}}</h2>
      <div class="education__list">
        {{#each education.items}}
        <div class="education__item">
          <h3 class="education__degree">{{degree}}</h3>
          <p class="education__institution">{{institution}}</p>
          <p class="education__period">{{period}}</p>
          {{#if description}}
          <p class="education__description">{{description}}</p>
          {{/if}}
        </div>
        {{/each}}
      </div>
    </div>
  </section>
  {{/if}}

  <!-- Contact Section -->
  {{#if contact}}
  <section class="section contact" id="contact">
    <div class="container">
      <h2 class="section__title">{{contact.title}}</h2>
      <p class="contact__description">{{contact.description}}</p>
      {{#if contact.email}}
      <a href="mailto:{{contact.email}}" class="btn btn--primary btn--large">Send Email</a>
      {{/if}}
    </div>
  </section>
  {{/if}}

  <!-- Footer -->
  <footer class="footer">
    <div class="container">
      <p class="footer__text">© {{year}} {{hero.name}}. Built with <a href="https://github.com/0xdps/folioport" target="_blank" rel="noopener noreferrer">FolioPort</a>.</p>
    </div>
  </footer>

  <script src="assets/js/scripts.min.js"></script>
</body>
</html>

