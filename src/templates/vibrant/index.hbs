<!DOCTYPE html>
<html lang="{{meta.language}}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  {{{metaTags}}}
  
  <link rel="icon" type="image/svg+xml" href="{{meta.favicon}}">
  <link rel="stylesheet" href="assets/css/styles.min.css">
  
  {{{schemaTag}}}
</head>
<body>
  <!-- Animated Background -->
  <div class="background-animation">
    <div class="floating-shape shape-1"></div>
    <div class="floating-shape shape-2"></div>
    <div class="floating-shape shape-3"></div>
    <div class="floating-shape shape-4"></div>
    <div class="floating-shape shape-5"></div>
  </div>

  <!-- Navigation -->
  <nav class="navbar" id="navbar">
    <div class="navbar__container">
      <div class="navbar__brand">
        <span class="navbar__logo">{{hero.name}}</span>
        <span class="navbar__tagline">{{hero.title}}</span>
      </div>
      
      <div class="navbar__menu" id="navbar-menu">
        <a href="#hero" class="navbar__link">Home</a>
        {{#if about}}<a href="#about" class="navbar__link">About</a>{{/if}}
        {{#if experience}}<a href="#experience" class="navbar__link">Experience</a>{{/if}}
        {{#if projects}}<a href="#projects" class="navbar__link">Projects</a>{{/if}}
        <a href="#contact" class="navbar__link">Contact</a>
        {{#if config.features.darkMode}}
        <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme">
          <span class="toggle-icon">🌙</span>
        </button>
        {{/if}}
      </div>
      
      <button class="navbar__toggle" id="navbar-toggle">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="hero" id="hero">
    <div class="hero__container">
      <div class="hero__content">
        {{#if hero.image}}
        <div class="hero__image-wrapper">
          <div class="hero__image">
            <img src="{{hero.image}}" alt="{{hero.name}}" />
          </div>
          <div class="hero__image-glow"></div>
        </div>
        {{else}}
        <div class="hero__image-wrapper">
          <div class="hero__image hero__image--placeholder">
            <svg xmlns="http://www.w3.org/2000/svg" width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
          </div>
          <div class="hero__image-glow"></div>
        </div>
        {{/if}}
        
        <div class="hero__text">
          <h1 class="hero__name">
            <span class="hero__name-text">{{hero.name}}</span>
            <span class="hero__name-gradient"></span>
          </h1>
          
          <div class="hero__title-wrapper">
            <h2 class="hero__title">{{hero.title}}</h2>
            <div class="hero__title-underline"></div>
          </div>
          
          {{#if hero.tagline}}
          <p class="hero__tagline">{{hero.tagline}}</p>
          {{/if}}
          
          {{#if hero.location}}
          <p class="hero__location">
            <span class="location-icon">📍</span>
            {{hero.location}}
          </p>
          {{/if}}
          
          <div class="hero__cta">
            {{#if hero.email}}
            <a href="mailto:{{hero.email}}" class="btn btn--primary">
              <span>Get In Touch</span>
              <span class="btn__glow"></span>
            </a>
            {{/if}}
            {{#if hero.github}}
            <a href="{{hero.github}}" target="_blank" rel="noopener" class="btn btn--secondary">
              <span>View Work</span>
              <span class="btn__glow"></span>
            </a>
            {{/if}}
          </div>
          
          <div class="hero__social">
            {{#if hero.linkedin}}
            <a href="{{hero.linkedin}}" target="_blank" rel="noopener" class="social-link" aria-label="LinkedIn">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </a>
            {{/if}}
            {{#if hero.github}}
            <a href="{{hero.github}}" target="_blank" rel="noopener" class="social-link" aria-label="GitHub">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
            </a>
            {{/if}}
            {{#if hero.twitter}}
            <a href="{{hero.twitter}}" target="_blank" rel="noopener" class="social-link" aria-label="Twitter">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
              </svg>
            </a>
            {{/if}}
            {{#if hero.website}}
            <a href="{{hero.website}}" target="_blank" rel="noopener" class="social-link" aria-label="Website">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="2" y1="12" x2="22" y2="12"></line>
                <path d="m12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
              </svg>
            </a>
            {{/if}}
          </div>
        </div>
      </div>
      
      <div class="hero__scroll">
        <div class="scroll-indicator">
          <span>Scroll</span>
          <div class="scroll-arrow"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- About Section -->
  {{#if about}}
  <section class="section about" id="about">
    <div class="container">
      <div class="section__header">
        <h2 class="section__title">About Me</h2>
        <div class="section__subtitle">Get to know me better</div>
      </div>
      
      <div class="about__content">
        <div class="about__text">
          <p class="about__bio">{{about.bio}}</p>
        </div>
        
        {{#if about.skills}}
        <div class="skills">
          <h3 class="skills__title">Skills & Expertise</h3>
          <div class="skills__grid">
            {{#each about.skills}}
            <div class="skill-card">
              <span class="skill-card__name">{{this}}</span>
              <div class="skill-card__glow"></div>
            </div>
            {{/each}}
          </div>
        </div>
        {{/if}}
      </div>
    </div>
  </section>
  {{/if}}

  <!-- Experience Section -->
  {{#if experience}}
  <section class="section experience" id="experience">
    <div class="container">
      <div class="section__header">
        <h2 class="section__title">{{experience.title}}</h2>
        <div class="section__subtitle">My professional journey</div>
      </div>
      
      <div class="timeline">
        {{#each experience.items}}
        <div class="timeline__item">
          <div class="timeline__marker"></div>
          <div class="timeline__content">
            <div class="timeline__card">
              <h3 class="timeline__title">{{role}}</h3>
              <h4 class="timeline__company">{{company}}</h4>
              <p class="timeline__period">{{period}}</p>
              {{#if description}}
              <p class="timeline__description">{{description}}</p>
              {{/if}}
              {{#if technologies}}
              <div class="timeline__tech">
                {{#each technologies}}
                <span class="tech-tag">{{this}}</span>
                {{/each}}
              </div>
              {{/if}}
            </div>
          </div>
        </div>
        {{/each}}
      </div>
    </div>
  </section>
  {{/if}}

  <!-- Projects Section -->
  {{#if projects}}
  <section class="section projects" id="projects">
    <div class="container">
      <div class="section__header">
        <h2 class="section__title">{{projects.title}}</h2>
        <div class="section__subtitle">Some of my recent work</div>
      </div>
      
      <div class="projects__grid">
        {{#each projects.items}}
        <article class="project-card">
          {{#if image}}
          <div class="project-card__image">
            <img src="{{image}}" alt="{{title}}">
          </div>
          {{/if}}
          <div class="project-card__header">
            <h3 class="project-card__title">{{title}}</h3>
            <div class="project-card__icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15,3 21,3 21,9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </div>
          </div>
          
          {{#if description}}
          <p class="project-card__description">{{description}}</p>
          {{/if}}
          
          {{#if technologies}}
          <div class="project-card__tech">
            {{#each technologies}}
            <span class="tech-tag">{{this}}</span>
            {{/each}}
          </div>
          {{/if}}
          
          <div class="project-card__links">
            {{#if link}}
            <a href="{{link}}" target="_blank" rel="noopener" class="project-link">GitHub</a>
            {{/if}}
            {{#if demo}}
            <a href="{{demo}}" target="_blank" rel="noopener" class="project-link">Live Demo</a>
            {{/if}}
          </div>
          
          <div class="project-card__glow"></div>
        </article>
        {{/each}}
      </div>
    </div>
  </section>
  {{/if}}

  <!-- Contact Section -->
  <section class="section contact" id="contact">
    <div class="container">
      <div class="section__header">
        <h2 class="section__title">Let's Work Together</h2>
        <div class="section__subtitle">Ready to start your next project?</div>
      </div>
      
      <div class="contact__content">
        <div class="contact__info">
          <p class="contact__text">I'm always interested in new opportunities and exciting projects. Let's chat!</p>
          
          <div class="contact__details">
            {{#if hero.email}}
            <a href="mailto:{{hero.email}}" class="contact__item">
              <div class="contact__icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
              </div>
              <div class="contact__info-text">
                <span class="contact__label">Email</span>
                <span class="contact__value">{{hero.email}}</span>
              </div>
            </a>
            {{/if}}
            
            {{#if hero.phone}}
            <a href="tel:{{hero.phone}}" class="contact__item">
              <div class="contact__icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                </svg>
              </div>
              <div class="contact__info-text">
                <span class="contact__label">Phone</span>
                <span class="contact__value">{{hero.phone}}</span>
              </div>
            </a>
            {{/if}}
          </div>
          
          <div class="contact__cta">
            {{#if hero.email}}
            <a href="mailto:{{hero.email}}" class="btn btn--primary btn--large">
              <span>Send Message</span>
              <span class="btn__glow"></span>
            </a>
            {{/if}}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <div class="container">
      <div class="footer__content">
        <p class="footer__text">
          &copy; {{currentYear}} {{hero.name}}. Built with 
          <a href="https://github.com/0xdps/folioport" target="_blank" rel="noopener" class="footer__link">FolioPort</a>.
        </p>
        
        <div class="footer__social">
          {{#if hero.linkedin}}
          <a href="{{hero.linkedin}}" target="_blank" rel="noopener" class="footer__social-link" aria-label="LinkedIn">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
          {{/if}}
          {{#if hero.github}}
          <a href="{{hero.github}}" target="_blank" rel="noopener" class="footer__social-link" aria-label="GitHub">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          </a>
          {{/if}}
          {{#if hero.twitter}}
          <a href="{{hero.twitter}}" target="_blank" rel="noopener" class="footer__social-link" aria-label="Twitter">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
            </svg>
          </a>
          {{/if}}
        </div>
      </div>
    </div>
  </footer>

  <script src="assets/js/scripts.min.js"></script>
</body>
</html>